# 默认模型。两种写法都行：
#   PI_MODEL=<provider>/<modelId>          （推荐，一个变量说清）
#   PI_PROVIDER=<provider> + PI_MODEL=<modelId>
# 命令行 --model / --provider 优先级更高。
# 模型 id 本身带斜杠（如 Qwen/Qwen3-...）时，用第一种写法，斜杠会原样保留。
PI_PROVIDER=modelscope
PI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# 模型目录。不填时，setup 只用上面这一条，baseUrl 走 PI_BASE_URL。
# 每条：provider|baseUrl|api|modelId[:显示名],modelId[:显示名]
# 多条用分号隔开。换行请保持在同一行，.env 不支持续行。
# PI_MODELS=modelscope|https://api-inference.modelscope.cn/v1|openai-completions|deepseek-ai/DeepSeek-V4-Flash-0731:DeepSeek-V4-Flash,Qwen/Qwen2.5-72B-Instruct;zhipu|https://open.bigmodel.cn/api/paas/v4|openai-completions|glm-4.5-air:GLM-4.5-Air

# 只在没写 PI_MODELS 时生效
PI_BASE_URL=https://api-inference.modelscope.cn/v1
# PI_API=openai-completions

# 模型轮换列表（官方 scopedModels + cycleModel / WS cycle_model / REST POST /model/cycle / CLI /cycle）。
# 逗号分隔，每项 provider/modelId[:thinkingLevel]。不填则默认用所有已配 Key 的模型派生一份。
# PI_SCOPED_MODELS=modelscope/deepseek-ai/DeepSeek-V4-Flash-0731:high,zhipu/glm-4.5-air:off

# 知识检索后端。默认 keyword（进程内关键词，零依赖，行为与以前一致）。
# 设 vector 则走官方 RAG 入口的可插拔向量检索：启动时把知识库切段→ embedding → 内存 cosine。
# PI_KNOWLEDGE_RETRIEVAL=vector
# vector 模式必须配 embedding 源（OpenAI 兼容 /v1/embeddings；Ollama 的 /v1/embeddings 也兼容）：
# PI_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
# PI_EMBEDDINGS_MODEL=bge-m3
# PI_EMBEDDINGS_KEY=

# 密钥只给 npm run setup 写进 ~/.pi/agent/auth.json，运行时不读这里。
# 默认 provider（PI_PROVIDER）用 PI_API_KEY；其余 provider 用 PI_API_KEY_<PROVIDER>（大写）。
# 已有密钥默认保留，覆盖才加 --force。切勿把填好的 .env 提交进 git。
PI_API_KEY=
# PI_API_KEY_ZHIPU=

# 内置编码工具档位（命令行 --builtin-tools 优先）
#   off      = 自定义工具 + read（技能走 SDK 原生 read；bash/edit/write 仍关）
#   readonly = 再打开 grep / find / ls
#   coding   = 再打开 bash / edit / write（能改磁盘、能跑 shell）
PI_BUILTIN_TOOLS=off

# 数据库路径。不填 = 内存 SQLite（每次启动都是示例 notes）
# PI_DATABASE_PATH=./data/app.db
